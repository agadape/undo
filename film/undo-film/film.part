 U.flash.value=Math.max(t>=T_RISE&&t<T_RISE+.09?1:0,t>=15.6&&t<15.66?.5:0,t>=T_PLAY&&t<T_PLAY+.06?.35:0,t>=T_REAL&&t<T_REAL+.05?.3:0);
 if(t>T_RISE&&t<16.2){const c=undo.userData.spine.localToWorld(new THREE.Vector3(0,.7,0)).project(cam);U.sc.value.set((c.x+1)/2,(c.y+1)/2);U.speed.value=1-sg(t,15.0,16.2)}
 if(stopped){const c=undo.userData.spine.localToWorld(new THREE.Vector3(0,.7,0)).project(cam);U.c.value.set((c.x+1)/2,(c.y+1)/2);const e=t-T_STOP;
