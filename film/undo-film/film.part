 if(s[2]==="phone"){const n=phoneN(phone.rotation.y),d=lerp(s[3],s[4],kk),off=v3(s[5],s[6],kk);const c=phone.position.clone().add(off);cam.position.copy(c.clone().add(n.multiplyScalar(d)));cam.lookAt(c)}
 else{cam.position.copy(v3(s[2],s[3],kk));cam.lookAt(v3(s[4],s[5],kk))}
 for(const[b,a]of[[T_RISE,.06],[15.6,.035],[T_STOP,.05],[85.75,.03],[86.3,.03]]){const q=t-b;if(q>0&&q<.6){cam.position.x+=Math.sin(q*60)*a*Math.exp(-q*6);cam.position.y+=Math.cos(q*47)*a*Math.exp(-q*6)}}
 cam.updateMatrixWorld(true);const isPh=s[2]==="phone",fo=isPh?s[7]:s[6],ap=isPh?s[8]:s[7];const fp=typeof fo==="function"?fo():new THREE.Vector3(...fo);post.dof.focus=cam.position.distanceTo(fp);post.dof.aper=ap*.42;post.dof.maxCoc=11;
