 phone.userData.l.intensity=3+(t>T_PRESS&&t<T_RISE?6*Math.exp(-(t-T_PRESS)*2):0)+(t>T_RISE&&t<T_UP?14*(1-sg(t,T_RISE,T_UP)):0);
