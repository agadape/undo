    "root_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "String",
      "type": "string",
      "definitions": {
        "BaseMetadata": {
          "description": "Base token metadata is shared across multiple tokens.",
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "base_uri": {
              "description": "Centralized gateway known to have reliable access to decentralized storage assets referenced by `reference` or `media` URLs.",
              "type": [
                "string",
                "null"
              ]
            },
            "copies": {
              "description": "Number of copies of this set of metadata in existence when the token was minted.",
              "type": [
                "string",
                "null"
              ]
            },
            "decimals": {
              "description": "Number of decimals to use when representing quantities of this token (in the case of a fungible-like token).",
              "type": [
                "string",
                "null"
              ]
            },
            "icon": {
              "description": "Data URL of icon.",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "description": "Unique identifier of the metadata.",
              "type": "string"
            },
            "name": {
              "description": "The name of the token, e.g. \"Silver Swords\" or \"Metaverse 3\".",
              "type": "string"
            },
            "reference": {
              "description": "URL to a JSON file with more information.",
              "type": [
                "string",
                "null"
              ]
            },
            "reference_hash": {
              "description": "Base64-encoded SHA-256 hash of JSON from the `reference` field. Required if `reference` is not `None`.",
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "description": "Token symbol, e.g. \"MOCHI\".",
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "ContractMetadata": {
          "description": "Top-level contract metadata.",
          "type": "object",
          "required": [
            "name",
            "spec"
          ],
          "properties": {
            "name": {
              "description": "Contract name. For example: `\"Zoink's Digitial Sword Collection\"`",
              "type": "string"
            },
            "spec": {
              "description": "Specification version. For example: `\"mt-1.0.0\"`",
              "type": "string"
            }
          }
        },
        "MtTransferApproval": {
          "type": "array",
          "items": [
            {
              "description": "NEAR Account Identifier.\n\nThis is a unique, syntactically valid, human-readable account identifier on the NEAR network.\n\n[See the crate-level docs for information about validation.](index.html#account-id-rules)\n\nAlso see [Error kind precedence](AccountId#error-kind-precedence).\n\n## Examples\n\n``` use near_account_id::AccountId;\n\nlet alice: AccountId = \"alice.near\".parse().unwrap();\n\nassert!(\"ƒelicia.near\".parse::<AccountId>().is_err()); // (ƒ is not f) ```",
              "type": "string"
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          ],
          "maxItems": 2,
          "minItems": 2
        },
        "Promise": true,
        "StorageBalance": {
          "description": "An account's storage balance.",
          "type": "object",
          "required": [
            "available",
            "total"
          ],
          "properties": {
            "available": {
              "description": "The amount of storage balance that is available for use.",
              "type": "string"
            },
            "total": {
              "description": "The total amount of storage balance.",
              "type": "string"
            }
          }
        },
        "StorageBalanceBounds": {
          "description": "Storage balance bounds.",
          "type": "object",
          "required": [
            "min"
          ],
          "properties": {
            "max": {
              "description": "The maximum storage balance.",
              "type": [
                "string",
                "null"
              ]
            },
            "min": {
