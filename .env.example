# Copy to .env and fill in. Never commit .env. All accounts are NEAR testnet.
# Spike scripts in spikes/ read this file (path: ../.env from spikes/); the web app reads it from undo/app (../../.env).
NEAR_NETWORK=testnet
NEAR_RPC_TESTNET=https://rpc.testnet.fastnear.com
NEAR_RPC_MAINNET=https://rpc.mainnet.fastnear.com

# Main testnet wallet (s3_create_account.mjs writes these). Also: posts court recommendations
# and is the S8 Sputnik DAO council member.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# Sub-accounts created by spikes (s7 = agent, s10 = gasless user)
NEAR_SUB_ACCOUNT_ID=
NEAR_SUB_PRIVATE_KEY=
NEAR_USER_ACCOUNT_ID=
NEAR_USER_PRIVATE_KEY=

# Spike contract accounts (s13 tokens, s20 undo token v0, s22/s21/s26 TEE verifiers)
NEAR_FT_CONTRACT_ID=
NEAR_FT_CONTRACT_PRIVATE_KEY=
NEAR_NFT_CONTRACT_ID=
NEAR_NFT_CONTRACT_PRIVATE_KEY=
NEAR_MT_CONTRACT_ID=
NEAR_MT_CONTRACT_PRIVATE_KEY=
NEAR_UNDO_CONTRACT_ID=
NEAR_UNDO_CONTRACT_PRIVATE_KEY=
NEAR_S22_CONTRACT_ID=
NEAR_S22_CONTRACT_PRIVATE_KEY=
NEAR_S21_CONTRACT_ID=
NEAR_S21_CONTRACT_PRIVATE_KEY=
NEAR_S26_FAKE_CONTRACT_ID=
NEAR_S26_FAKE_CONTRACT_PRIVATE_KEY=
NEAR_S26_REAL_CONTRACT_ID=
NEAR_S26_REAL_CONTRACT_PRIVATE_KEY=

# Undo v1 contracts
NEAR_UNDO_DEMO_CONTRACT_ID=        # public demo contract (locked, 5-minute window)
NEAR_UNDO_V1_CONTRACT_ID=          # dev contract (90-second window)
NEAR_UNDO_V1_CONTRACT_PRIVATE_KEY=

# Demo-account faucet for the web app (falls back to NEAR_S21_CONTRACT_* when unset)
NEAR_UNDO_FAUCET_ID=
NEAR_UNDO_FAUCET_PRIVATE_KEY=

# Coba Curi challenge
COBACURI_CONTRACT_ID=
COBACURI_DEMO_ID=
COBACURI_DEMO_PRIVATE_KEY=         # the bait key (published only when the team decides)
COBACURI_GUARD_ID=
COBACURI_GUARD_PRIVATE_KEY=
COBACURI_GUARD_FC_KEY=             # function-call key: panic / finalize / unlock / release_expired
COBACURI_PUBLISH_KEY=0             # 1 = show the bait key on /coba-curi

# Web app on a public deployment
COUNCIL_PASSCODE=                  # required for council actions
COURT_MAX_RUNS_PER_HOUR=20

# APIs
NEAR_AI_API_KEY=                   # free $10 via nearbuilders.org/join, key from cloud.near.ai
ONECLICK_JWT=

# Optional notifications (Coba Curi guard)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
